{
  "extends": "./tsconfig.base.json",
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "workers/**/*.ts",
    "adapters/**/*.ts",
    "tests/contracts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "operator",
    "services",
    "scripts",
    "studio",
    "tests/fixtures"
  ],
  "compilerOptions": {
    "jsx": "preserve"
  }
}
